# ─── Secrets ─────────────────────────────────────────────────────────
# .env currently holds live production credentials (Supabase service-role
# key, Stripe secret + webhook secret, Resend, Outlook app password).
# Never commit these. Use .env.example to document required variables.
.env
.env.*
!.env.example

# ─── Dependencies ────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/

# ─── Build output ────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ─── Vite / tooling caches ───────────────────────────────────────────
.vite/
node_modules/.vite/
.eslintcache
*.tsbuildinfo

# ─── Netlify ─────────────────────────────────────────────────────────
.netlify/

# ─── Supabase CLI ────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ─── Logs ────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Test / coverage ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor / OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
