# Copy to .env and fill in real values. Never commit .env.
#
# Anything prefixed VITE_ is inlined into the client bundle by Vite and is
# therefore PUBLIC. Only put publishable/anon keys behind a VITE_ prefix.
# Server-only secrets must stay unprefixed and be set as Supabase Edge
# Function secrets or Netlify environment variables, never referenced from
# src/.

# ─── Client-side (public — shipped to the browser) ────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_REDEEM_COMP_URL=

# ─── Server-side only (secret — must never reach the client) ──────────
# OPENAI_API_KEY is deliberately absent: it is set as a Supabase Edge
# Function secret, not a build-time variable. The AI features call OpenAI
# from the `chat` edge function, so no browser-side OpenAI key is needed.
# Do not reintroduce it here, and never behind a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
OUTLOOK_APP_PASSWORD=

# ─── Misc ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
